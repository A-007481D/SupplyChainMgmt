%% ===== RELATIONSHIPS =====
%% many to many supplierOrder to Product resulting in a ProductOrder associative table
    Supplier "1" --> "0..*" SupplierOrder : places
    SupplierOrder "0..*" -- "1..*" ProductOrder : contains
    ProductOrder "*" -- "*" Product : references
    Product "1" --> "0..*" StockMovement : tracked by
    StockMovement "0..*" --> "0..1" SupplierOrder : related to
    Stock "1" --> "*" Product : holds

%% ===== ENUM RELATIONSHIPS =====

    SupplierOrder --> OrderStatus : uses
    StockMovement --> MovementType : uses
%%    StockMovement --> ValuationMethod : uses
